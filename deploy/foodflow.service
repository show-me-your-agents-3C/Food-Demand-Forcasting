[Unit]
Description=FreshFlow Food Demand Agent API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Food-Demand-Forcasting
EnvironmentFile=/home/ubuntu/Food-Demand-Forcasting/.env
ExecStart=/home/ubuntu/Food-Demand-Forcasting/.venv/bin/uvicorn src.api.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
